{
    "preamble": [
        ".286",
        "OPTION NOSCOPED",
        "dgroup group dseg, bss"
    ],
    "coda": [ "END start" ],
    "include": "lst/gs_gs2.inc",
    "in_segments": [
        "seg000", "seg001", "seg002", "seg003", "seg004", "dseg", "bss"
    ],
