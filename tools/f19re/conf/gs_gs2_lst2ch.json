        { "seg": "dseg", "begin": "0x65e0", "end": "0x9ebf" }
    ],
    "subs": [
        { "from": "assume (ds|es|ss):dseg\\b", "to": "assume \\1:dgroup" }
    ],
    "extract": [],
    "replace": []
}